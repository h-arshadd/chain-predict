# Virtual environment
venv/

# Environment variables (contains DB credentials)
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# VS Code (keep settings.json -- shared project convention, e.g. lint suppressions;
# ignore everything else, since launch.json/tasks.json etc. tend to hold
# machine-specific paths)
.vscode/*
!.vscode/settings.json

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Package build artifacts
*.egg-info/

# Generated outputs from plot_indicators.py
indicator_charts/

# ML: generated outputs, never commit
crypto_pipeline/ml/models/
crypto_pipeline/ml/artifacts/
crypto_pipeline/ml/pipeline_out/
crypto_pipeline/ml/outputs/

crypto_pipeline/stats/outputs/
crypto_pipeline/preprocessing_lab/outputs/
crypto_pipeline/preprocessing_lab/model_evaluation/outputs/
crypto_pipeline/backtest/backtest_outputs
crypto_pipeline/signals/signal_outputs
crypto_pipeline/validation/outputs

ta_lib-*.whl

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Backend (FastAPI, once created)
backend/__pycache__/
backend/*.pyc
backend/.env